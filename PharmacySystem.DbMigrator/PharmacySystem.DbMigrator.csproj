<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PharmacySystem.DbMigrator</RootNamespace>
    <AssemblyName>PharmacySystem.DbMigrator</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="dbup-sqlserver" Version="6.0.16" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The migration scripts live under Database/Migrations and are embedded here so the tool
         is self-contained. They are matched by the "...Migrations." resource-name prefix. -->
    <EmbeddedResource Include="..\Database\Migrations\*.sql">
      <Link>Migrations\%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
