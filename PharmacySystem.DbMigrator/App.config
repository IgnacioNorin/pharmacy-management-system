<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- Optional: drop a ConnectionStrings.config next to the exe with a 'connection' entry.
       A CLI argument or the PHARMACY_DB_CONNECTION environment variable takes precedence. -->
  <connectionStrings configSource="ConnectionStrings.config" />
</configuration>
