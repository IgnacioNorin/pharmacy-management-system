<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RootNamespace>PharmacySystem</RootNamespace>
    <AssemblyName>PharmacySystem</AssemblyName>
    <StartupObject>PharmacySystem.Program</StartupObject>
    <ApplicationIcon />

    <Description>Pharmacy Management System - POS and inventory management</Description>
    <Product>PharmacySystem</Product>
    <Copyright>Copyright © 2025 Ignacio Norín - MIT License</Copyright>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <!-- A few tests exercise this assembly's internal helpers (ViewParse, StartupError). -->
  <ItemGroup>
    <InternalsVisibleTo Include="PharmacySystem.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmacySystem.Domain\PharmacySystem.Domain.csproj" />
    <ProjectReference Include="..\PharmacySystem.Data\PharmacySystem.Data.csproj" />
    <ProjectReference Include="..\PharmacySystem.Business\PharmacySystem.Business.csproj" />
    <ProjectReference Include="..\PharmacySystem.Presentation\PharmacySystem.Presentation.csproj" />
    <ProjectReference Include="..\PharmacySystem.Wpf\PharmacySystem.Wpf.csproj" />
  </ItemGroup>

  <!-- Legacy resource file: keeps the HTML ticket template plus a set of (currently unused) PNG
       icons. The .Designer.cs is checked in; do not regenerate it on build. -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <LastGenOutput>Properties\Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="ConnectionStrings.config" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ConnectionStrings.config')" />
    <None Update="ConnectionStrings.config.example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
