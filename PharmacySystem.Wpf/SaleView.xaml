<UserControl x:Class="PharmacySystem.Ui.SaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppCanvasBrush}">
    <UserControl.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>
        <Style x:Key="Fld" TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,16,4"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top" Text="Ventas" FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- Header -->
        <GroupBox DockPanel.Dock="Top" Header="Comprobante" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Tipo documento"/>
                <ComboBox  Grid.Column="1" x:Name="cboDocType" Margin="0,4,16,4"
                           SelectionChanged="cboDocType_SelectionChanged"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Lbl}" Text="Cliente"/>
                <TextBox   Grid.Column="3" x:Name="txtClientDoc" Style="{StaticResource Fld}" IsReadOnly="True"/>
                <TextBox   Grid.Column="4" x:Name="txtClientName" Style="{StaticResource Fld}" IsReadOnly="True"/>
                <Button    Grid.Column="5" x:Name="btnPickClient" Content="Buscar cliente" Margin="0,4,8,4" Click="btnPickClient_Click"/>
                <Button    Grid.Column="6" x:Name="btnCreditNote" Content="Nota de crédito" Margin="0,4" Click="btnCreditNote_Click"/>
            </Grid>
        </GroupBox>

        <!-- Factura recipient -->
        <GroupBox x:Name="grpFactura" DockPanel.Dock="Top" Header="Receptor (factura)" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="RUT"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtRecTaxId" Style="{StaticResource Fld}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource Lbl}" Text="Razón social"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="txtRecName" Style="{StaticResource Fld}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Giro"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtRecActivity" Style="{StaticResource Fld}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Lbl}" Text="Dirección"/>
                <TextBox   Grid.Row="1" Grid.Column="3" x:Name="txtRecAddress" Style="{StaticResource Fld}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Comuna"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtRecCommune" Style="{StaticResource Fld}"/>
            </Grid>
        </GroupBox>

        <!-- Product entry -->
        <GroupBox DockPanel.Dock="Top" Header="Agregar producto" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Lbl}" Text="Código"/>
                <TextBox   Grid.Column="1" x:Name="txtCode" Style="{StaticResource Fld}" KeyDown="txtCode_KeyDown"/>
                <Button    Grid.Column="2" x:Name="btnPickProduct" Content="Buscar" Margin="0,4,12,4" Click="btnPickProduct_Click"/>
                <TextBox   Grid.Column="3" x:Name="txtProductName" Style="{StaticResource Fld}" IsReadOnly="True"/>
                <TextBlock Grid.Column="4" Style="{StaticResource Lbl}" Text="Cant."/>
                <TextBox   Grid.Column="5" x:Name="txtAmount" Style="{StaticResource Fld}" Text="1"/>
                <TextBlock Grid.Column="6" Style="{StaticResource Lbl}" Text="P. venta"/>
                <TextBox   Grid.Column="7" x:Name="txtPrice" Style="{StaticResource Fld}"/>
                <Button    Grid.Column="8" x:Name="btnAdd" Content="Agregar" Margin="0,4" Click="btnAdd_Click"/>
            </Grid>
        </GroupBox>

        <!-- Bottom: totals + payment -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Total:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtTotal" Width="120" IsReadOnly="True" Text="0"/>
                    <TextBlock Text="Paga con:" Width="80" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtPayWith" Width="120" Text="0"/>
                    <Button x:Name="btnCalc" Content="Calcular" Margin="8,0,0,0" Click="btnCalc_Click"/>
                    <TextBlock Text="Cambio:" Width="70" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtChange" Width="120" IsReadOnly="True" Text="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Forma de pago:" Width="100" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cboPaymentMethod" Width="150"/>
                    <Button x:Name="btnMixedPayment" Content="Pago mixto…" Margin="8,0,0,0" Click="btnMixedPayment_Click"/>
                    <TextBlock x:Name="lblMixedPayment" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#0B2545"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1" x:Name="btnFinish" Style="{StaticResource PrimaryButton}" Content="Terminar venta" Width="170" Height="46"
                    VerticalAlignment="Bottom" Click="btnFinish_Click"/>
        </Grid>

        <!-- Cart -->
        <GroupBox Header="Detalle de la venta" Padding="8">
        <DataGrid x:Name="dgCart"
                  AutoGenerateColumns="False"
                  HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Producto" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Cantidad" Width="110" Binding="{Binding QuantityText}"/>
                <DataGridTextColumn Header="Precio venta" Width="140" Binding="{Binding PriceText}"/>
                <DataGridTextColumn Header="Subtotal" Width="140" Binding="{Binding SubTotalText}"/>
                <DataGridTemplateColumn Header="" Width="86">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Quitar" Padding="8,2" MinHeight="0" Click="btnRemoveLine_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </GroupBox>
    </DockPanel>
</UserControl>
