<Window x:Class="PharmacySystem.Wpf.PrintSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Imprimir venta"
        Height="620" Width="380"
        MinHeight="360" MinWidth="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
            <Button x:Name="btnPrint" Content="Imprimir" Width="120" Height="32" Click="btnPrint_Click"/>
        </StackPanel>
        <Border BorderBrush="#D8DCE2" BorderThickness="1" Background="White">
            <wv2:WebView2 x:Name="webView"/>
        </Border>
    </DockPanel>
</Window>
