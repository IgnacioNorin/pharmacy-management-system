<UserControl x:Class="PharmacySystem.Ui.ClientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppCanvasBrush}">

    <UserControl.Resources>
        <!-- Grid cells never overflow the viewport: proportional columns, ellipsis on long
             values, full value on hover. The complete record lives in the detail panel below. -->
        <Style x:Key="GridCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24">

        <TextBlock DockPanel.Dock="Top" Text="Clientes" FontSize="22" FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- Search -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtSearch" Width="260" Height="24"
                     ToolTip="Busca por nombre, documento, razón social o email"/>
            <Button x:Name="btnSearch" Content="Buscar" Width="90" Height="26" Margin="8,0,0,0" Click="btnSearch_Click"/>
            <Button x:Name="btnClearSearch" Content="Limpiar" Width="90" Height="26" Margin="6,0,0,0" Click="btnClearSearch_Click"/>
        </StackPanel>

        <!-- Detail panel: the full record for the selected row / the new-record form. -->
        <GroupBox DockPanel.Dock="Bottom" Header="Datos del cliente" Margin="0,10,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,4,8,4"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Height" Value="24"/>
                        <Setter Property="Margin" Value="0,4,16,4"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Documento"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtDocument"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Nombre completo"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="txtName"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Dirección"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtAddress"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Teléfono"/>
                <TextBox   Grid.Row="1" Grid.Column="3" x:Name="txtPhone"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Razón social"/>
                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="txtBusinessName"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Giro"/>
                <TextBox   Grid.Row="2" Grid.Column="3" x:Name="txtActivity"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Comuna"/>
                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="txtCommune"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Email"/>
                <TextBox   Grid.Row="3" Grid.Column="3" x:Name="txtEmail"/>

                <CheckBox  Grid.Row="4" Grid.Column="1" x:Name="chkIsCompany" Content="Es empresa"
                           VerticalAlignment="Center" Margin="0,6,0,2"/>

                <StackPanel Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,6,0,2">
                    <Button x:Name="btnSave" Content="Guardar" Width="120" Height="30" Click="btnSave_Click"/>
                    <Button x:Name="btnClearForm" Content="Limpiar" Width="100" Height="30" Margin="8,0,0,0" Click="btnClearForm_Click"/>
                    <Button x:Name="btnDelete" Content="Eliminar" Width="100" Height="30" Margin="8,0,0,0" Click="btnDelete_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Pager -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="btnFirst" Content="|&lt;" Width="40" Height="26" Click="btnFirst_Click"/>
            <Button x:Name="btnPrev"  Content="&lt;"  Width="40" Height="26" Margin="4,0,0,0" Click="btnPrev_Click"/>
            <Button x:Name="btnNext"  Content="&gt;"  Width="40" Height="26" Margin="4,0,0,0" Click="btnNext_Click"/>
            <Button x:Name="btnLast"  Content="&gt;|" Width="40" Height="26" Margin="4,0,0,0" Click="btnLast_Click"/>
            <TextBlock x:Name="lblPage" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- Master list: key columns only, always fits the viewport (no horizontal scroll).
             Full record -> detail panel below. -->
        <DataGrid x:Name="dgClients"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  ColumnWidth="*"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="dgClients_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Documento" Width="1.1*" Binding="{Binding Document}"
                                    ElementStyle="{StaticResource GridCell}"/>
                <DataGridTextColumn Header="Nombre" Width="2*" Binding="{Binding Name}"
                                    ElementStyle="{StaticResource GridCell}"/>
                <DataGridTextColumn Header="Teléfono" Width="1*" Binding="{Binding Phone}"
                                    ElementStyle="{StaticResource GridCell}"/>
                <DataGridTextColumn Header="Comuna" Width="1*" Binding="{Binding Commune}"
                                    ElementStyle="{StaticResource GridCell}"/>
                <DataGridTextColumn Header="Email" Width="1.7*" Binding="{Binding Email}"
                                    ElementStyle="{StaticResource GridCell}"/>
                <DataGridCheckBoxColumn Header="Empresa" Width="70" Binding="{Binding IsCompany}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
