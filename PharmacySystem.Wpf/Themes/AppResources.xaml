<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- The app's design tokens. The WPF-UI Fluent theme and control dictionaries are merged
         ahead of this one, in code, by LoginHost.EnsureApplication (this project has no App.xaml).
         Keep this file free of ThemesDictionary/ControlsDictionary so the theme is owned in one
         place. -->

    <!-- Brand palette -->
    <Color x:Key="BrandNavyColor">#FF0B2545</Color>
    <Color x:Key="BrandNavyDeepColor">#FF081B34</Color>
    <SolidColorBrush x:Key="BrandNavyBrush" Color="{StaticResource BrandNavyColor}" />
    <SolidColorBrush x:Key="BrandNavyDeepBrush" Color="{StaticResource BrandNavyDeepColor}" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="AppCanvasBrush" Color="#FFF5F6F8" />
    <SolidColorBrush x:Key="CardStrokeBrush" Color="#FFD8DCE2" />

    <!-- Status accents (shared with the alert severity model) -->
    <SolidColorBrush x:Key="StatusDangerBrush" Color="#FFA73E38" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFB06A22" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#FF2E7D32" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF6B7684" />

    <!-- Dashboard tile: the Fluent card look with a fixed footprint. -->
    <Style x:Key="DashboardTile" TargetType="ui:Card"
           BasedOn="{StaticResource {x:Type ui:Card}}">
        <Setter Property="Width" Value="230" />
        <Setter Property="Margin" Value="0,0,14,14" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="TileCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TileValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>

    <Style x:Key="TileSub" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- App-wide button sizing. The Fluent button needs more room than the old fixed
         Width/Height="26" values gave it (text was clipping); enforce a comfortable minimum
         so screens that still carry legacy sizes render correctly. -->
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,4" />
    </Style>

</ResourceDictionary>
