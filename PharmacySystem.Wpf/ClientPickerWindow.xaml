<Window x:Class="PharmacySystem.Wpf.ClientPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar cliente"
        Height="500" Width="820"
        MinHeight="340" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtSearch" Width="260" Height="24"/>
            <Button x:Name="btnSearch" Content="Buscar" Width="90" Height="26" Margin="8,0,0,0" Click="btnSearch_Click"/>
            <Button x:Name="btnClear" Content="Limpiar" Width="90" Height="26" Margin="6,0,0,0" Click="btnClear_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSelect" Content="Seleccionar" Width="130" Height="30" Click="btnSelect_Click"/>
            <Button Content="Cancelar" Width="90" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <DataGrid x:Name="dgClients"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  MouseDoubleClick="dgClients_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Documento" Width="130" Binding="{Binding Document}"/>
                <DataGridTextColumn Header="Nombre" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Razón social" Width="180" Binding="{Binding BusinessName}"/>
                <DataGridCheckBoxColumn Header="Empresa" Width="70" Binding="{Binding IsCompany}"/>
                <DataGridTextColumn Header="Dirección" Width="160" Binding="{Binding Address}"/>
                <DataGridTextColumn Header="Teléfono" Width="110" Binding="{Binding Phone}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
