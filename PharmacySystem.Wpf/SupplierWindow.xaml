<ui:FluentWindow x:Class="PharmacySystem.Ui.SupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Title="Proveedores"
        Height="620" Width="900"
        MinHeight="460" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="Proveedores"/>

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtSearch" Width="260" Height="24"
                     ToolTip="Busca por razón social, documento o correo"/>
            <Button x:Name="btnSearch" Content="Buscar" Width="90" Height="26" Margin="8,0,0,0" Click="btnSearch_Click"/>
            <Button x:Name="btnClearSearch" Content="Limpiar" Width="90" Height="26" Margin="6,0,0,0" Click="btnClearSearch_Click"/>
        </StackPanel>

        <GroupBox DockPanel.Dock="Bottom" Header="Detalle del proveedor" Margin="0,10,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,4,8,4"/>
                    </Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Height" Value="24"/>
                        <Setter Property="Margin" Value="0,4,16,4"/>
                    </Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Número Documento"/>
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="txtDocument"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Razón Social"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="txtCompanyName"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Correo"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtEmail"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Teléfono"/>
                <TextBox   Grid.Row="1" Grid.Column="3" x:Name="txtPhone"/>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,2">
                    <Button x:Name="btnSave" Content="Guardar" Width="120" Height="30" Click="btnSave_Click"/>
                    <Button x:Name="btnClearForm" Content="Limpiar" Width="100" Height="30" Margin="8,0,0,0" Click="btnClearForm_Click"/>
                    <Button x:Name="btnDelete" Content="Eliminar" Width="100" Height="30" Margin="8,0,0,0" Click="btnDelete_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="btnFirst" Content="|&lt;" Width="40" Height="26" Click="btnFirst_Click"/>
            <Button x:Name="btnPrev"  Content="&lt;"  Width="40" Height="26" Margin="4,0,0,0" Click="btnPrev_Click"/>
            <Button x:Name="btnNext"  Content="&gt;"  Width="40" Height="26" Margin="4,0,0,0" Click="btnNext_Click"/>
            <Button x:Name="btnLast"  Content="&gt;|" Width="40" Height="26" Margin="4,0,0,0" Click="btnLast_Click"/>
            <TextBlock x:Name="lblPage" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <DataGrid x:Name="dgData"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" SelectionMode="Single"
                  GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  SelectionChanged="dgData_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Número Documento" Width="140" Binding="{Binding Document}"/>
                <DataGridTextColumn Header="Razón Social" Width="*" Binding="{Binding CompanyName}"/>
                <DataGridTextColumn Header="Correo" Width="200" Binding="{Binding Email}"/>
                <DataGridTextColumn Header="Teléfono" Width="120" Binding="{Binding Phone}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
    </DockPanel>
</ui:FluentWindow>
