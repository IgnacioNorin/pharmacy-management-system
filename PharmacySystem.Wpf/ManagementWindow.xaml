<ui:FluentWindow x:Class="PharmacySystem.Ui.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowCornerPreference="Round"
        Title="Gestión"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
    </Window.Resources>

    <TabControl x:Name="tabControl" Margin="12">
        <!-- ================= Productos ================= -->
        <TabItem x:Name="tabProduct" Header="Productos">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="txtSearchProduct" Width="240" Margin="0,0,8,0"/>
                        <Button x:Name="btnSearchProduct" Content="Buscar" Width="90" Height="26" Margin="0,0,6,0"
                                Click="btnSearchProduct_Click"/>
                        <Button x:Name="btnClearSearch" Content="Limpiar" Width="90" Height="26"
                                Click="btnClearSearch_Click"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="btnProductFirst" Content="|&lt;" Width="40" Height="26" Margin="0,0,4,0" Click="btnProductFirst_Click"/>
                        <Button x:Name="btnProductPrev" Content="&lt;" Width="40" Height="26" Margin="0,0,4,0" Click="btnProductPrev_Click"/>
                        <Button x:Name="btnProductNext" Content="&gt;" Width="40" Height="26" Margin="0,0,4,0" Click="btnProductNext_Click"/>
                        <Button x:Name="btnProductLast" Content="&gt;|" Width="40" Height="26" Margin="0,0,12,0" Click="btnProductLast_Click"/>
                        <TextBlock x:Name="lblProductPage" VerticalAlignment="Center" Foreground="Gray"/>
                        <Button x:Name="btnProductLots" Content="Ver lotes" Width="100" Height="26" Margin="16,0,0,0" Click="btnProductLots_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgProduct" SelectionChanged="dgProduct_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Width="90" Binding="{Binding Code}"/>
                            <DataGridTextColumn Header="Nombre" Width="*" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Descripción" Width="*" Binding="{Binding Description}"/>
                            <DataGridTextColumn Header="Categoría" Width="120" Binding="{Binding CategoryText}"/>
                            <DataGridTextColumn Header="Stock" Width="60" Binding="{Binding Stock}"/>
                            <DataGridTextColumn Header="Vencimiento" Width="100" Binding="{Binding ExpirationDateText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Detalle de Producto" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Código:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtCodeProduct"/>
                    <TextBlock Text="Nombre:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtNameProduct"/>
                    <TextBlock Text="Descripción:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtDescriptionProduct"/>
                    <TextBlock Text="Categoría:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cboCategory" DisplayMemberPath="Text"/>
                    <CheckBox x:Name="chkTaxAffected" Content="Afecto a IVA" Margin="0,10,0,0" IsChecked="True"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="btnSaveProduct" Content="Guardar" Width="86" Height="28" Margin="0,0,6,0" Click="btnSaveProduct_Click"/>
                        <Button x:Name="btnCleanProduct" Content="Limpiar" Width="86" Height="28" Margin="0,0,6,0" Click="btnCleanProduct_Click"/>
                        <Button x:Name="btnDeleteProduct" Content="Eliminar" Width="86" Height="28" Click="btnDeleteProduct_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ================= Categorías ================= -->
        <TabItem x:Name="tabCategory" Header="Categorías">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock DockPanel.Dock="Top" Text="Lista de Categorías" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="dgCategory" SelectionChanged="dgCategory_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Descripción" Width="*" Binding="{Binding Description}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Detalle de Categoría" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Descripción:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtDescriptionCategory"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="btnSaveCategory" Content="Guardar" Width="86" Height="28" Margin="0,0,6,0" Click="btnSaveCategory_Click"/>
                        <Button x:Name="btnCleanCategory" Content="Limpiar" Width="86" Height="28" Margin="0,0,6,0" Click="btnCleanCategory_Click"/>
                        <Button x:Name="btnDeleteCategory" Content="Eliminar" Width="86" Height="28" Click="btnDeleteCategory_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ================= Precios ================= -->
        <TabItem x:Name="tabPrices" Header="Precios">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Por liberar (en stock, sin precio de venta)" Style="{StaticResource SectionTitle}"/>
                <DataGrid x:Name="dgReleasable" Grid.Row="1" Grid.Column="0" Margin="0,0,10,8"
                          SelectionChanged="dgPrice_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Width="80" Binding="{Binding Code}"/>
                        <DataGridTextColumn Header="Producto" Width="*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Stock" Width="55" Binding="{Binding Stock}"/>
                        <DataGridTextColumn Header="Costo" Width="90" Binding="{Binding Cost}"/>
                        <DataGridTextColumn Header="Precio venta" Width="90" Binding="{Binding SalePrice}"/>
                        <DataGridTextColumn Header="Margen %" Width="80" Binding="{Binding Margin}"/>
                        <DataGridTextColumn Header="IVA" Width="45" Binding="{Binding Iva}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="En comercialización" Style="{StaticResource SectionTitle}"/>
                <DataGrid x:Name="dgCommercialized" Grid.Row="3" Grid.Column="0" Margin="0,0,10,0"
                          SelectionChanged="dgPrice_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Width="80" Binding="{Binding Code}"/>
                        <DataGridTextColumn Header="Producto" Width="*" Binding="{Binding Name}"/>
                        <DataGridTextColumn Header="Stock" Width="55" Binding="{Binding Stock}"/>
                        <DataGridTextColumn Header="Costo" Width="90" Binding="{Binding Cost}"/>
                        <DataGridTextColumn Header="Precio venta" Width="90" Binding="{Binding SalePrice}"/>
                        <DataGridTextColumn Header="Margen %" Width="80" Binding="{Binding Margin}"/>
                        <DataGridTextColumn Header="IVA" Width="45" Binding="{Binding Iva}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2">
                    <TextBlock x:Name="lblSelectedProduct" Text="Producto: (ninguno seleccionado)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Nuevo precio de venta:" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtNewPrice" Width="160" HorizontalAlignment="Left"
                             PreviewTextInput="PriceEntry_PreviewTextInput"/>
                    <TextBlock Text="Motivo (opcional):" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="txtPriceReason" Width="420" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="btnApplyPrice" Content="Guardar precio / Liberar" Width="200" Height="28" Margin="0,0,10,0"
                                Click="btnApplyPrice_Click"/>
                        <Button x:Name="btnUnrelease" Content="Retirar de comercialización" Width="200" Height="28"
                                Click="btnUnrelease_Click"/>
                    </StackPanel>
                </StackPanel>

                <DockPanel Grid.Row="2" Grid.Column="1" Grid.RowSpan="2">
                    <TextBlock DockPanel.Dock="Top" Text="Historial de precios del producto seleccionado" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="dgPriceHistory">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Width="130" Binding="{Binding Date}"/>
                            <DataGridTextColumn Header="Evento" Width="120" Binding="{Binding Event}"/>
                            <DataGridTextColumn Header="Precio" Width="90" Binding="{Binding Price}"/>
                            <DataGridTextColumn Header="Costo" Width="90" Binding="{Binding Cost}"/>
                            <DataGridTextColumn Header="Usuario" Width="110" Binding="{Binding User}"/>
                            <DataGridTextColumn Header="Motivo" Width="*" Binding="{Binding Reason}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ================= Tienda ================= -->
        <TabItem x:Name="tabStore" Header="Tienda">
            <StackPanel Margin="16" MaxWidth="460" HorizontalAlignment="Left">
                <TextBlock Text="Detalle de mi Tienda" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Número Documento:" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtTaxId"/>
                <TextBlock Text="Razón Social:" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtLegalName"/>
                <TextBlock Text="Correo:" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtEmail"/>
                <TextBlock Text="Teléfono:" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtPhone"/>
                <TextBlock Text="Dirección:" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtAddress"/>
                <TextBlock Text="Facturación" Style="{StaticResource SectionTitle}" Margin="0,16,0,6"/>
                <TextBlock Text="Tasa IVA (%):" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtTaxRate" Width="120" HorizontalAlignment="Left"/>
                <TextBlock Text="Documento por defecto:" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cboDefaultDocType" Width="220" HorizontalAlignment="Left"/>
                <Button x:Name="btnSaveStore" Content="Guardar" Width="120" Height="30" Margin="0,20,0,0"
                        HorizontalAlignment="Left" Click="btnSaveStore_Click"/>
            </StackPanel>
        </TabItem>
    </TabControl>
</ui:FluentWindow>
