<UserControl x:Class="PharmacySystem.Ui.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="{DynamicResource AppCanvasBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Inicio" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>

        <WrapPanel Grid.Row="1" x:Name="tilesPanel">
            <ui:Card x:Name="tileSales" Style="{DynamicResource DashboardTile}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Receipt24" FontSize="15"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="VENTAS DE HOY" Style="{DynamicResource TileCaption}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="lblSalesValue" Text="$0" Style="{DynamicResource TileValue}"/>
                    <TextBlock x:Name="lblSalesSub" Text="0 operaciones" Style="{DynamicResource TileSub}"/>
                </StackPanel>
            </ui:Card>

            <ui:Card x:Name="tileAlerts" Style="{DynamicResource DashboardTile}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Alert24" FontSize="15"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="ALERTAS ABIERTAS" Style="{DynamicResource TileCaption}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="lblAlertsValue" Text="0" Style="{DynamicResource TileValue}"
                               Foreground="{DynamicResource StatusDangerBrush}"/>
                    <TextBlock x:Name="lblAlertsSub" Text="0 urgentes · 0 pendientes" Style="{DynamicResource TileSub}"/>
                </StackPanel>
            </ui:Card>

            <ui:Card x:Name="tileExpiring" Style="{DynamicResource DashboardTile}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CalendarClock24" FontSize="15"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="POR VENCER" Style="{DynamicResource TileCaption}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="lblExpiringValue" Text="0" Style="{DynamicResource TileValue}"
                               Foreground="{DynamicResource StatusWarningBrush}"/>
                    <TextBlock Text="productos con fecha próxima" Style="{DynamicResource TileSub}"/>
                </StackPanel>
            </ui:Card>

            <ui:Card x:Name="tileStock" Style="{DynamicResource DashboardTile}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="15"
                                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="STOCK CRÍTICO" Style="{DynamicResource TileCaption}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="lblStockValue" Text="0" Style="{DynamicResource TileValue}"
                               Foreground="{DynamicResource StatusDangerBrush}"/>
                    <TextBlock Text="por debajo del umbral" Style="{DynamicResource TileSub}"/>
                </StackPanel>
            </ui:Card>
        </WrapPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <ui:Card x:Name="pnlAttention" Grid.Column="0" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Requiere atención"
                               FontWeight="Bold" Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgAttention"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                              Background="Transparent" BorderThickness="0"
                              MouseDoubleClick="dgAttention_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severidad" Width="90" Binding="{Binding Severity}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding SeverityBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Producto" Width="200" Binding="{Binding Product}"/>
                            <DataGridTextColumn Header="Detalle" Width="*" Binding="{Binding Detail}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </ui:Card>

            <ui:Card x:Name="pnlQuickActions" Grid.Column="2" Padding="16" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Acciones rápidas" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ui:Button x:Name="btnNewSale" Content="Nueva venta" Appearance="Primary"
                               Icon="{ui:SymbolIcon Cart24}"
                               HorizontalAlignment="Stretch" Click="btnNewSale_Click"/>
                    <ui:Button x:Name="btnNewPurchase" Content="Nueva compra" Appearance="Secondary"
                               Icon="{ui:SymbolIcon Receipt24}"
                               HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="btnNewPurchase_Click"/>
                    <ui:Button x:Name="btnManageProducts" Content="Gestionar productos" Appearance="Secondary"
                               Icon="{ui:SymbolIcon BoxMultiple24}"
                               HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="btnManageProducts_Click"/>
                </StackPanel>
            </ui:Card>
        </Grid>
    </Grid>
</UserControl>
