<UserControl x:Class="PharmacySystem.Wpf.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6F8"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D8DCE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>
        <Style x:Key="TileCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7684"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style x:Key="TileSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7684"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Grid.Row="0" x:Name="tilesPanel">
            <Border x:Name="tileSales" Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="VENTAS DE HOY" Style="{StaticResource TileCaption}"/>
                    <TextBlock x:Name="lblSalesValue" Text="$0" Style="{StaticResource TileValue}"/>
                    <TextBlock x:Name="lblSalesSub" Text="0 operaciones" Style="{StaticResource TileSub}"/>
                </StackPanel>
            </Border>
            <Border x:Name="tileAlerts" Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="ALERTAS ABIERTAS" Style="{StaticResource TileCaption}"/>
                    <TextBlock x:Name="lblAlertsValue" Text="0" Style="{StaticResource TileValue}" Foreground="#A73E38"/>
                    <TextBlock x:Name="lblAlertsSub" Text="0 urgentes · 0 pendientes" Style="{StaticResource TileSub}"/>
                </StackPanel>
            </Border>
            <Border x:Name="tileExpiring" Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="POR VENCER" Style="{StaticResource TileCaption}"/>
                    <TextBlock x:Name="lblExpiringValue" Text="0" Style="{StaticResource TileValue}" Foreground="#B06A22"/>
                    <TextBlock Text="productos con fecha próxima" Style="{StaticResource TileSub}"/>
                </StackPanel>
            </Border>
            <Border x:Name="tileStock" Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="STOCK CRÍTICO" Style="{StaticResource TileCaption}"/>
                    <TextBlock x:Name="lblStockValue" Text="0" Style="{StaticResource TileValue}" Foreground="#A73E38"/>
                    <TextBlock Text="por debajo del umbral" Style="{StaticResource TileSub}"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="pnlAttention" Grid.Column="0" Background="White" BorderBrush="#D8DCE2"
                    BorderThickness="1" CornerRadius="4" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Requiere atención" Style="{StaticResource PanelTitle}"/>
                    <DataGrid x:Name="dgAttention"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                              MouseDoubleClick="dgAttention_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severidad" Width="90" Binding="{Binding Severity}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding SeverityBrush}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Producto" Width="200" Binding="{Binding Product}"/>
                            <DataGridTextColumn Header="Detalle" Width="*" Binding="{Binding Detail}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border x:Name="pnlQuickActions" Grid.Column="2" Background="White" BorderBrush="#D8DCE2"
                    BorderThickness="1" CornerRadius="4" Padding="14" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Acciones rápidas" Style="{StaticResource PanelTitle}"/>
                    <Button x:Name="btnNewSale" Content="Nueva venta" Height="34" Margin="0,4,0,0" Click="btnNewSale_Click"/>
                    <Button x:Name="btnNewPurchase" Content="Nueva compra" Height="34" Margin="0,8,0,0" Click="btnNewPurchase_Click"/>
                    <Button x:Name="btnManageProducts" Content="Gestionar productos" Height="34" Margin="0,8,0,0" Click="btnManageProducts_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
