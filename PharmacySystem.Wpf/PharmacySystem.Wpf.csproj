<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PharmacySystem.Wpf</RootNamespace>
    <AssemblyName>PharmacySystem.Wpf</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmacySystem.Presentation\PharmacySystem.Presentation.csproj" />
  </ItemGroup>

  <!-- PrintSaleWindow: thermal-printer plaintext path (System.Drawing.Printing) and the spooler
       check (System.ServiceProcess.ServiceController). System.Printing and Microsoft.CSharp come
       with the WindowsDesktop SDK. -->
  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>

</Project>
