<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PharmacySystem.Wpf</RootNamespace>
    <AssemblyName>PharmacySystem.Wpf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmacySystem.Presentation\PharmacySystem.Presentation.csproj" />
  </ItemGroup>

  <!-- PrintSaleWindow: renders the HTML ticket in WebView2 (Edge/Chromium) and prints through
       its browser print dialog; the thermal plain-text path uses System.Drawing.Printing and the
       spooler check uses System.ServiceProcess.ServiceController. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

</Project>
