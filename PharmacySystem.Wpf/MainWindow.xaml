<Window x:Class="PharmacySystem.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pharmacy System"
        Height="720" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,3,8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,10,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#173963"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#0B2545"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8DA9C4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="16,14,8,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" Background="#0B2545">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="14,16,14,10">
                <TextBlock Text="Bienvenido" Foreground="#8DA9C4" FontSize="11"/>
                <TextBlock x:Name="lblUser" Text="" Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="lblUserRole" Text="" Foreground="#8DA9C4" FontSize="11" Margin="0,1,0,4"/>
                <TextBlock>
                    <Hyperlink x:Name="lnkChangePassword" Foreground="#8DA9C4" Click="lnkChangePassword_Click">
                        Cambiar contraseña
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="#173963" Margin="0,0,0,4"/>

            <!-- Bottom -->
            <Border DockPanel.Dock="Bottom" Height="1" Background="#173963" Margin="0,4,0,0"/>
            <Button DockPanel.Dock="Bottom" x:Name="btnExit" Content="Salir" Style="{StaticResource NavButton}"
                    Margin="8,0,8,10" Click="btnExit_Click"/>

            <!-- Nav items -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="navPanel" Margin="0,6,0,6">
                    <Button x:Name="btnHome" Content="Inicio" Style="{StaticResource NavButton}" Click="btnHome_Click"/>

                    <TextBlock x:Name="lblGroupOperacion" Text="OPERACIÓN" Style="{StaticResource GroupHeader}"/>
                    <Button x:Name="btnSales" Content="Ventas" Style="{StaticResource NavButton}" Click="btnSales_Click"/>
                    <Button x:Name="btnPurchases" Content="Compras" Style="{StaticResource NavButton}" Click="btnPurchases_Click"/>

                    <TextBlock x:Name="lblGroupGestion" Text="GESTIÓN" Style="{StaticResource GroupHeader}"/>
                    <Button x:Name="btnManagement" Content="Gestión" Style="{StaticResource NavButton}" Click="btnManagement_Click"/>
                    <Button x:Name="btnSuppliers" Content="Proveedores" Style="{StaticResource NavButton}" Click="btnSuppliers_Click"/>
                    <Button x:Name="btnClients" Content="Clientes" Style="{StaticResource NavButton}" Click="btnClients_Click"/>
                    <Button x:Name="btnUsers" Content="Usuarios" Style="{StaticResource NavButton}" Click="btnUsers_Click"/>
                    <Button x:Name="btnRoles" Content="Roles" Style="{StaticResource NavButton}" Click="btnRoles_Click"/>

                    <TextBlock x:Name="lblGroupConsulta" Text="CONSULTA" Style="{StaticResource GroupHeader}"/>
                    <Button x:Name="btnReports" Content="Reportería" Style="{StaticResource NavButton}" Click="btnReports_Click"/>
                    <Button x:Name="btnCashCount" Content="Arqueo de caja" Style="{StaticResource NavButton}" Click="btnCashCount_Click"/>
                    <Button x:Name="btnAuditLog" Content="Bitácora" Style="{StaticResource NavButton}" Click="btnAuditLog_Click"/>
                    <Button x:Name="btnAlerts" Style="{StaticResource NavButton}" Click="btnAlerts_Click">
                        <DockPanel LastChildFill="False" Width="170">
                            <TextBlock Text="Alertas" VerticalAlignment="Center"/>
                            <Border x:Name="alertBadge" DockPanel.Dock="Right" Background="#A73E38" CornerRadius="9"
                                    MinWidth="18" Height="18" Padding="5,0" Visibility="Collapsed">
                                <TextBlock x:Name="lblAlertBadge" Text="0" Foreground="White" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Content -->
        <ContentControl Grid.Column="1" x:Name="contentHost"/>
    </Grid>
</Window>
