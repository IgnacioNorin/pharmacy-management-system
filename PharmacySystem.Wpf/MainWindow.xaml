<ui:FluentWindow x:Class="PharmacySystem.Ui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Pharmacy System"
                 Height="720" Width="1180"
                 MinHeight="560" MinWidth="900"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="8,2,8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0,10,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#173963"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1F4A7E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#0B2545"/>
        </Style>
        <Style x:Key="NavIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#CBD8E8"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8DA9C4"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="18,16,8,4"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sidebar, full height -->
        <DockPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="#0B2545">
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="16,18,14,10">
                <TextBlock Text="Bienvenido" Foreground="#8DA9C4" FontSize="11"/>
                <TextBlock x:Name="lblUser" Text="" Foreground="White" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="lblUserRole" Text="" Foreground="#8DA9C4" FontSize="11" Margin="0,1,0,4"/>
                <TextBlock>
                    <Hyperlink x:Name="lnkChangePassword" Foreground="#8DA9C4" Click="lnkChangePassword_Click">
                        Cambiar contraseña
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="#173963" Margin="0,0,0,4"/>

            <!-- Bottom -->
            <Border DockPanel.Dock="Bottom" Height="1" Background="#173963" Margin="0,4,0,0"/>
            <Button DockPanel.Dock="Bottom" x:Name="btnExit" Style="{StaticResource NavButton}"
                    Margin="8,0,8,10" Click="btnExit_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="SignOut24" Style="{StaticResource NavIcon}"/>
                    <TextBlock Text="Salir" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Nav items -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="navPanel" Margin="0,6,0,6">
                    <Button x:Name="btnHome" Style="{StaticResource NavButton}" Click="btnHome_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Inicio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="lblGroupOperacion" Text="OPERACIÓN" Style="{StaticResource GroupHeader}"/>
                    <Button x:Name="btnSales" Style="{StaticResource NavButton}" Click="btnSales_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Cart24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Ventas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnPurchases" Style="{StaticResource NavButton}" Click="btnPurchases_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Receipt24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Compras" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="lblGroupGestion" Text="GESTIÓN" Style="{StaticResource GroupHeader}"/>
                    <Button x:Name="btnManagement" Style="{StaticResource NavButton}" Click="btnManagement_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="BoxMultiple24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Gestión" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnSuppliers" Style="{StaticResource NavButton}" Click="btnSuppliers_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="VehicleTruck24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Proveedores" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnClients" Style="{StaticResource NavButton}" Click="btnClients_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Clientes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnUsers" Style="{StaticResource NavButton}" Click="btnUsers_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonBoard24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Usuarios" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnRoles" Style="{StaticResource NavButton}" Click="btnRoles_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ShieldKeyhole24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Roles" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="lblGroupConsulta" Text="CONSULTA" Style="{StaticResource GroupHeader}"/>
                    <Button x:Name="btnReports" Style="{StaticResource NavButton}" Click="btnReports_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ChartMultiple24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Reportería" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCashCount" Style="{StaticResource NavButton}" Click="btnCashCount_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Money24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Arqueo de caja" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnAuditLog" Style="{StaticResource NavButton}" Click="btnAuditLog_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ClipboardTaskListLtr24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Bitácora" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnAlerts" Style="{StaticResource NavButton}" Click="btnAlerts_Click">
                        <DockPanel LastChildFill="False" Width="182">
                            <ui:SymbolIcon Symbol="Alert24" Style="{StaticResource NavIcon}"/>
                            <TextBlock Text="Alertas" VerticalAlignment="Center"/>
                            <Border x:Name="alertBadge" DockPanel.Dock="Right" Background="#A73E38" CornerRadius="9"
                                    MinWidth="18" Height="18" Padding="5,0" Visibility="Collapsed"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="lblAlertBadge" Text="0" Foreground="White" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Content -->
        <ContentControl Grid.Row="1" Grid.Column="1" x:Name="contentHost"
                        Background="{DynamicResource AppCanvasBrush}"/>

        <!-- Caption buttons over the content column -->
        <ui:TitleBar Grid.Row="0" Grid.Column="1" Title="" ShowMaximize="True" ShowMinimize="True"/>
    </Grid>
</ui:FluentWindow>
