<ui:FluentWindow x:Class="PharmacySystem.Ui.SupplierPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowCornerPreference="Round"
        Title="Seleccionar proveedor"
        Height="480" Width="700"
        MinHeight="320" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="txtSearch" Width="240" Height="24"/>
            <Button x:Name="btnSearch" Content="Buscar" Width="90" Height="26" Margin="8,0,0,0" Click="btnSearch_Click"/>
            <Button x:Name="btnClear" Content="Limpiar" Width="90" Height="26" Margin="6,0,0,0" Click="btnClear_Click"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnSelect" Content="Seleccionar" Width="130" Height="30" Click="btnSelect_Click"/>
            <Button Content="Cancelar" Width="90" Height="30" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>

        <DataGrid x:Name="dgSuppliers"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                  MouseDoubleClick="dgSuppliers_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Documento" Width="130" Binding="{Binding Document}"/>
                <DataGridTextColumn Header="Razón social" Width="*" Binding="{Binding CompanyName}"/>
                <DataGridTextColumn Header="Correo" Width="170" Binding="{Binding Email}"/>
                <DataGridTextColumn Header="Teléfono" Width="110" Binding="{Binding Phone}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</ui:FluentWindow>
