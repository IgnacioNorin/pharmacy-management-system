<ui:FluentWindow x:Class="PharmacySystem.Ui.PurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowCornerPreference="Round"
        Title="Registrar compra"
        Height="700" Width="920"
        MinHeight="560" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">

        <!-- Header -->
        <GroupBox DockPanel.Dock="Top" Header="Comprobante" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
                    <Style TargetType="TextBox"><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0,4,16,4"/></Style>
                </Grid.Resources>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tipo documento"/>
                <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="cboDocType" Height="24" Margin="0,4,16,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="N° documento"/>
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="txtDocNumber"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Proveedor"/>
                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="txtSupplierDoc" IsReadOnly="True"/>
                <TextBox   Grid.Row="1" Grid.Column="3" x:Name="txtSupplierName" IsReadOnly="True"/>
                <Button    Grid.Row="1" Grid.Column="4" x:Name="btnPickSupplier" Content="Buscar proveedor"
                           Width="140" Height="26" Margin="0,4" Click="btnPickSupplier_Click"/>
            </Grid>
        </GroupBox>

        <!-- Product entry -->
        <GroupBox DockPanel.Dock="Top" Header="Agregar producto" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,6,0"/></Style>
                    <Style TargetType="TextBox"><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
                </Grid.Resources>

                <TextBlock Grid.Column="0" Text="Código"/>
                <TextBox   Grid.Column="1" x:Name="txtCode" KeyDown="txtCode_KeyDown"/>
                <Button    Grid.Column="2" x:Name="btnPickProduct" Content="Buscar" Width="70" Height="26" Margin="0,0,12,0" Click="btnPickProduct_Click"/>
                <TextBox   Grid.Column="3" x:Name="txtProductName" IsReadOnly="True"/>
                <TextBlock Grid.Column="4" Text="Cant."/>
                <TextBox   Grid.Column="5" x:Name="txtAmount" Text="1"/>
                <TextBlock Grid.Column="6" Text="Vence"/>
                <DatePicker Grid.Column="7" x:Name="dpExpiry" Height="24" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="8" Text="P. compra"/>
                <TextBox   Grid.Column="9" x:Name="txtPrice"/>
                <Button    Grid.Column="10" x:Name="btnAdd" Content="Agregar" Width="90" Height="26" Click="btnAdd_Click"/>
            </Grid>
        </GroupBox>

        <!-- Totals + finish -->
        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock x:Name="lblVat" Foreground="Gray"/>
                <TextBlock x:Name="lblTotal" FontWeight="Bold" FontSize="16" Text="Total: 0"/>
            </StackPanel>
            <Button x:Name="btnFinish" Content="Registrar compra" Width="180" Height="34"
                    HorizontalAlignment="Right" Click="btnFinish_Click"/>
        </Grid>

        <!-- Cart -->
        <DataGrid x:Name="dgCart"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column"
                  SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Width="110" Binding="{Binding Code}"/>
                <DataGridTextColumn Header="Producto" Width="*" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Cantidad" Width="90" Binding="{Binding QuantityText}"/>
                <DataGridTextColumn Header="Vencimiento" Width="110" Binding="{Binding ExpiryText}"/>
                <DataGridTextColumn Header="P. compra" Width="110" Binding="{Binding PriceText}"/>
                <DataGridTextColumn Header="Subtotal" Width="120" Binding="{Binding SubTotalText}"/>
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Quitar" Padding="6,1" Click="btnRemoveLine_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</ui:FluentWindow>
