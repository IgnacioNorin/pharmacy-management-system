<ui:FluentWindow x:Class="PharmacySystem.Ui.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Iniciar sesión"
                 Height="460" Width="760"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel, full height -->
        <Border Grid.Column="0" Background="{DynamicResource BrandNavyBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Border Width="72" Height="72" CornerRadius="36"
                        Background="#1A3A63" HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="34" Foreground="White"/>
                </Border>
                <TextBlock Text="PharmacySystem" Foreground="White" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,16,0,4"/>
                <TextBlock Text="Gestión de farmacia y punto de venta"
                           Foreground="#9FB6D1" FontSize="12" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="190"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="40,0">
            <TextBlock Text="Iniciar sesión" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Ingresa tus credenciales para continuar"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                       Margin="0,2,0,22"/>

            <TextBlock Text="Número de documento" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="txtDocument" PlaceholderText="Ej. 12345678"
                        Icon="{ui:SymbolIcon Person24}" Margin="0,0,0,14"/>

            <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ui:PasswordBox x:Name="txtPassword" PlaceholderText="Tu contraseña"
                            Icon="{ui:SymbolIcon Key24}"/>

            <ui:Button x:Name="btnEnter" Content="Ingresar" Appearance="Primary"
                       Icon="{ui:SymbolIcon ArrowRight24}"
                       HorizontalAlignment="Stretch" Margin="0,22,0,0"
                       IsDefault="True" Click="btnEnter_Click"/>
            <ui:Button x:Name="btnExit" Content="Salir" Appearance="Secondary"
                       HorizontalAlignment="Stretch" Margin="0,8,0,0"
                       IsCancel="True" Click="btnExit_Click"/>
        </StackPanel>

        <!-- Caption buttons only; window is draggable by the whole top strip -->
        <ui:TitleBar Grid.ColumnSpan="2" VerticalAlignment="Top" Title=""
                     ShowMaximize="False" ShowMinimize="False"/>
    </Grid>
</ui:FluentWindow>
