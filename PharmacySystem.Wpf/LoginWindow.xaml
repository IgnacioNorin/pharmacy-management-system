<Window x:Class="PharmacySystem.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión"
        Height="300" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PharmacySystem" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"
                   Foreground="#0B2545"/>

        <TextBlock Grid.Row="1" Text="Número Documento:" Margin="0,0,0,2"/>
        <TextBox   Grid.Row="2" x:Name="txtDocument" Height="26" Margin="0,0,0,12"/>

        <TextBlock Grid.Row="3" Text="Contraseña:" Margin="0,0,0,2"/>
        <PasswordBox Grid.Row="4" x:Name="txtPassword" Height="26"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnEnter" Content="Ingresar" Width="110" Height="30" IsDefault="True"
                    Margin="0,0,8,0" Click="btnEnter_Click"/>
            <Button x:Name="btnExit" Content="Salir" Width="90" Height="30" IsCancel="True"
                    Click="btnExit_Click"/>
        </StackPanel>
    </Grid>
</Window>
