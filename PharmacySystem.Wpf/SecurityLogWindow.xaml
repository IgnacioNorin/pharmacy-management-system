<ui:FluentWindow x:Class="PharmacySystem.Ui.SecurityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowCornerPreference="Round"
        Title="Bitácora de acciones"
        Height="560" Width="920"
        MinHeight="360" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="dpFrom" Width="120"/>
            <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="16,0,6,0"/>
            <DatePicker x:Name="dpTo" Width="120"/>
            <Button x:Name="btnConsult" Content="Consultar" Width="110" Height="26" Margin="16,0,0,0"
                    Click="btnConsult_Click"/>
            <TextBlock x:Name="lblCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <DataGrid x:Name="dgEvents"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha y hora" Width="150"
                                    Binding="{Binding At, StringFormat=dd/MM/yyyy HH:mm:ss}"/>
                <DataGridTextColumn Header="Usuario" Width="130" Binding="{Binding ActorName}"/>
                <DataGridTextColumn Header="Acción" Width="130" Binding="{Binding Action}"/>
                <DataGridTextColumn Header="Entidad" Width="90" Binding="{Binding Entity}"/>
                <DataGridTextColumn Header="Id" Width="55" Binding="{Binding EntityId}"/>
                <DataGridTextColumn Header="Detalle" Width="*" Binding="{Binding Summary}"/>
                <DataGridTextColumn Header="Equipo" Width="110" Binding="{Binding Station}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</ui:FluentWindow>
