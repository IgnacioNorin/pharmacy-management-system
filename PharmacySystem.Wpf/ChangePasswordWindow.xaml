<Window x:Class="PharmacySystem.Wpf.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cambiar contraseña"
        Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="lblMandatory" Grid.Row="0" Grid.ColumnSpan="2"
                   Text="Debe cambiar su contraseña antes de continuar."
                   Margin="0,0,0,12" TextWrapping="Wrap" Visibility="Collapsed"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Contraseña actual" VerticalAlignment="Center"/>
        <PasswordBox x:Name="txtCurrent" Grid.Row="1" Grid.Column="1" Margin="0,4" Height="24"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Nueva contraseña" VerticalAlignment="Center"/>
        <PasswordBox x:Name="txtNew" Grid.Row="2" Grid.Column="1" Margin="0,4" Height="24"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Confirmar contraseña" VerticalAlignment="Center"/>
        <PasswordBox x:Name="txtConfirm" Grid.Row="3" Grid.Column="1" Margin="0,4" Height="24"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnCancel" Content="Cancelar" Width="110" Height="30" Margin="0,0,8,0"
                    IsCancel="True" Click="btnCancel_Click"/>
            <Button x:Name="btnSave" Content="Guardar" Width="150" Height="30"
                    IsDefault="True" Click="btnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
