<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PharmacySystem.Domain</RootNamespace>
    <AssemblyName>PharmacySystem.Domain</AssemblyName>
    <!-- Nullable reference types adopted incrementally, project by project. Once a project is
         clean, its nullable warnings are promoted to errors so it cannot regress. -->
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

</Project>
