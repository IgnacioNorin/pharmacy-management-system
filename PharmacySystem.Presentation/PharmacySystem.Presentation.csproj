<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately has no reference to System.Windows.Forms: presenters and view
       interfaces must stay free of UI types so they can be unit tested without a Form. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PharmacySystem.Presentation</RootNamespace>
    <AssemblyName>PharmacySystem.Presentation</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmacySystem.Domain\PharmacySystem.Domain.csproj" />
    <ProjectReference Include="..\PharmacySystem.Business\PharmacySystem.Business.csproj" />
  </ItemGroup>

  <!-- Report exporters (CSV needs nothing; XLSX uses ClosedXML; PDF uses the GDI build of
       PDFsharp/MigraDoc, which is fully managed - no native binaries to package). None of
       these pull in a UI type, so the project stays unit-testable without a Form. -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.95.4" />
    <PackageReference Include="PDFsharp-MigraDoc-GDI" Version="1.50.5147" />
  </ItemGroup>

</Project>
