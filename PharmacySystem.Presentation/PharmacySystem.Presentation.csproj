<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately has no reference to System.Windows.Forms: presenters and view
       interfaces must stay free of UI types so they can be unit tested without a Form. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PharmacySystem.Presentation</RootNamespace>
    <AssemblyName>PharmacySystem.Presentation</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmacySystem.Domain\PharmacySystem.Domain.csproj" />
    <ProjectReference Include="..\PharmacySystem.Business\PharmacySystem.Business.csproj" />
  </ItemGroup>

  <!-- Report exporters: CSV needs nothing; XLSX uses ClosedXML; PDF uses PDFsharp/MigraDoc 6.x
       (cross-platform, fully managed - the old separate -GDI package is gone). Neither pulls in
       a UI type, so the project stays unit-testable without a Form. -->
  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.0" />
  </ItemGroup>

</Project>
