<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PharmacySystem.Business</RootNamespace>
    <AssemblyName>PharmacySystem.Business</AssemblyName>
    <!-- Nullable reference types adopted incrementally, project by project. Once a project is
         clean, its nullable warnings are promoted to errors so it cannot regress. -->
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmacySystem.Domain\PharmacySystem.Domain.csproj" />
    <ProjectReference Include="..\PharmacySystem.Data\PharmacySystem.Data.csproj" />
  </ItemGroup>

</Project>
