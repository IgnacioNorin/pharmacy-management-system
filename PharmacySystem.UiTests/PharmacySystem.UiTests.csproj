<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PharmacySystem.UiTests</RootNamespace>
    <AssemblyName>PharmacySystem.UiTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- References the application assembly for the few tests that exercise its internal helpers
       (ViewParse, StartupError). -->
  <ItemGroup>
    <ProjectReference Include="..\PharmacySystem\PharmacySystem.csproj" />
    <ProjectReference Include="..\PharmacySystem.Presentation\PharmacySystem.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ConnectionStrings.config" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ConnectionStrings.config')" />
    <None Include="ConnectionStrings.config.example" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ConnectionStrings.config.example')" />
  </ItemGroup>

</Project>
