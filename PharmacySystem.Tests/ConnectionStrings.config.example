<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <!-- Copy this file to ConnectionStrings.config (ignored by git) and fill in your own credentials. -->
  <!-- Integration tests run against this database inside try/finally blocks that clean up their own rows. -->
  <add name="connection" connectionString="Server=#HereYourServer#;database=PharmacyDB;User Id=#HereYourUser#;Password=#HereYourPassword#;" providerName="System.Data.SqlClient"/>
</connectionStrings>
