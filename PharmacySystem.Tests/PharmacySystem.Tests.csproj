<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>PharmacySystem.Tests</RootNamespace>
    <AssemblyName>PharmacySystem.Tests</AssemblyName>
    <!-- Test code opts out of nullable: the annotations add churn without the safety payoff
         they give production code (a test that dereferences null just fails, loudly, in CI). -->
    <Nullable>disable</Nullable>
    <WarningsAsErrors />
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmacySystem.Domain\PharmacySystem.Domain.csproj" />
    <ProjectReference Include="..\PharmacySystem.Data\PharmacySystem.Data.csproj" />
    <ProjectReference Include="..\PharmacySystem.Business\PharmacySystem.Business.csproj" />
    <ProjectReference Include="..\PharmacySystem.Presentation\PharmacySystem.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

</Project>
