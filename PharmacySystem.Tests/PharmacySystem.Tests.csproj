<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <RootNamespace>PharmacySystem.Tests</RootNamespace>
    <AssemblyName>PharmacySystem.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PharmacySystem.Domain\PharmacySystem.Domain.csproj" />
    <ProjectReference Include="..\PharmacySystem.Data\PharmacySystem.Data.csproj" />
    <ProjectReference Include="..\PharmacySystem.Business\PharmacySystem.Business.csproj" />
    <ProjectReference Include="..\PharmacySystem.Presentation\PharmacySystem.Presentation.csproj" />
    <!-- Still referenced because the Service classes have not moved yet; it is what keeps
         the suite tied to Visual Studio's MSBuild. Dropping it is the last step of the migration. -->
    <ProjectReference Include="..\PharmacySystem\PharmacySystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="ConnectionStrings.config" CopyToOutputDirectory="PreserveNewest" Condition="Exists('ConnectionStrings.config')" />
    <None Include="ConnectionStrings.config.example" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
